{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "ask": ["Bash(git push*)"]
  },
  "autoMemoryDirectory": "~/.claude/memory/blockbeagle"
}
